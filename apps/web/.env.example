# ──────────────────────────────────────────────
# MCOM Web — Environment Variables
# Copy to .env and fill in values before running.
# ──────────────────────────────────────────────

# Frontend dev server port
VITE_PORT=9023

# Backend origin used by the Vite dev proxy for /api (dev only)
VITE_API_TARGET=http://localhost:9024

# Direct API base URL — used by all API calls.
# Include the backend's global /api prefix.
# DEV: http://localhost:9024/api
# PROD: https://your-api-domain.com/api
VITE_API_URL=http://localhost:9024/api

# Payments are processed by MCOM Central Hub Solution (MCOM Pay).
# Stripe Elements uses the same Stripe account as MCOM Central Hub.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Public PayPal client ID (same app as MCOM Central Hub). Optional: the current
# PayPal flow uses the MCOM Pay approval URL, but this is required if you mount
# the official PayPal Buttons SDK.
VITE_PAYPAL_CLIENT_ID=
