# ──────────────────────────────────────────────
# MCOM Web — Environment Variables
# Copy to .env and fill in values before running.
# ──────────────────────────────────────────────

# Frontend dev server port
VITE_PORT=3000

# Backend origin used by the Vite dev proxy for /api (dev only)
VITE_API_TARGET=http://localhost:3001

# Direct API base URL — used by all API calls in production.
# DEV: http://localhost:3001  (also used by Vite proxy)
# PROD: https://your-api-domain.com (no trailing /api)
VITE_API_URL=http://localhost:3001

# Stripe publishable key (same Stripe account as MCOM Solutions billing)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
