# ──────────────────────────────────────────────
# MCOM API — Environment Variables
# Copy to .env and fill in values before running.
# ──────────────────────────────────────────────

# Application
NODE_ENV=development          # development | production | test
PORT=9024                     # API listen port

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_NAME=mcomvcard

# TypeORM
TYPEORM_SYNC=false            # Never enable in production

# Authentication
JWT_SECRET=                   # REQUIRED — change to a long random string in production
JWT_EXPIRES_IN=1h             # Access token lifetime
REFRESH_TOKEN_EXPIRES_IN=7d   # Refresh token cookie lifetime

# Public URLs (used in email links, CORS, Swagger)
API_PUBLIC_URL=http://localhost:9024/api
WEB_PUBLIC_URL=http://localhost:9023

# CORS (comma-separated origins for production)
CORS_ORIGINS=

# Logger
LOG_FORMAT=pretty             # pretty | json

# Mail (optional)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_SECURE=false

# Resend transactional email (preferred over SMTP when set)
RESEND_API_KEY=
RESEND_FROM="MCOM VCard <onboarding@resend.dev>"

# Redis response cache (optional; in-memory fallback when unreachable)
REDIS_URL=redis://localhost:6379

# Contact form admin recipient (falls back to MAIL_FROM)
CONTACT_ADMIN_EMAIL=

# MCOM Solutions Central Hub (SSO)
MCOM_SOLUTIONS_URL=http://localhost:3010

# Application OAuth 2.0 Credentials
MCOM_CLIENT_ID=mcom-vcards
MCOM_CLIENT_SECRET=change-me

# Inbound System API Key — authorizes MCOM Solutions to call /api/v1/system/*
# (sent as x-mcom-solution-api-key or x-api-key). MCOM_SOLUTION_API_KEY is
# accepted as a legacy alias.
MCOM_API_KEY=change-me
MCOM_SOLUTION_API_KEY=change-me

# HMAC signing for server-to-server requests (permissions/packages sync)
MCOM_HMAC_SECRET=change-me

# Webhook Verification Secret — HMAC key for inbound lifecycle webhooks.
# Central uses the app's webhook secret when configured; otherwise it falls
# back to the app's HMAC secret, so keep this equal to MCOM_HMAC_SECRET when
# no separate webhook secret is set in the Console.
MCOM_WEBHOOK_SECRET=change-me

# Shared JWT SSO Secret — verifies the legacy Direct Dashboard Handshake
SSO_SECRET=change-me

# Configured App Settings
MCOM_PLATFORM_SLUG=vcards
# Must be the URI registered for this app in MCOM Console. The API bridges
# GET /auth/callback to the SPA callback page (WEB_PUBLIC_URL/auth/callback).
MCOM_REDIRECT_URI=http://localhost:9024/auth/callback
MCOM_SCOPES=profile email business membership packages
# Central Hub page where a user without VCard access can buy a membership
MCOM_MEMBERSHIP_URL=http://localhost:3000/dashboard/memberships

# White-label platform mode (this app is NOT white-label)
MCOM_WHITELABEL_ENABLED=false

# ── Direct app-to-app communication (Ecosystem Service Mesh M2M) ──
MCOM_SERVICE_ENABLED=true
MCOM_SERVICE_BASE_URL=http://localhost:9024
MCOM_SERVICE_SCOPES=profile email service:read service:write
# Optional comma-separated ingress allowlist (empty = Central registry policy)
MCOM_ALLOWED_CALLERS=

# ── MCOM Wallet + MCOM Pay partner integration ──
# Centralized prepaid wallet (MCOM credits) and the MCOM Pay gateway.
# All in-app charges are created server-side and settled from the wallet.
MCOM_WALLET_ENABLED=true
MCOM_PAY_ENABLED=true
# Optional override for the Central Hub wallet top-up page
# (defaults to ${MCOM_SOLUTIONS_URL}/dashboard/wallet)
MCOM_WALLET_TOPUP_URL=

# Seed admin (optional — created on first run if provided)
SEED_ADMIN_EMAIL=admin@centralhubsolution.com
SEED_ADMIN_PASSWORD=AdminPass2026!
