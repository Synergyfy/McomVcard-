PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=mcomvcard
# JWT secret must be provided in production and by CI. Set to a secure value locally.
JWT_SECRET=
# For safety, keep TYPEORM_SYNC disabled by default. Set to 'true' only for local dev when
# you need schema auto-sync. NEVER enable in production.
TYPEORM_SYNC=false

# Optional: Provide an email and password for a seed admin user. If provided, the seed script will create this user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Comma-separated list of allowed CORS origins in production (e.g. "https://app.example.com,https://www.example.com").
# Leave empty in development (allows all origins).
CORS_ORIGINS=
