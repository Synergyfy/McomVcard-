# ──────────────────────────────────────────────
# MCOM API — Environment Variables
# Copy to .env and fill in values before running.
# ──────────────────────────────────────────────

# Application
NODE_ENV=development          # development | production | test
PORT=3001                     # API listen port

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_NAME=mcomvcard

# TypeORM
TYPEORM_SYNC=false            # Never enable in production

# Authentication
JWT_SECRET=                   # REQUIRED — change to a long random string in production
JWT_EXPIRES_IN=1h             # Access token lifetime
REFRESH_TOKEN_EXPIRES_IN=7d   # Refresh token cookie lifetime

# Public URLs (used in email links, CORS, Swagger)
API_PUBLIC_URL=http://localhost:3001/api
WEB_PUBLIC_URL=http://localhost:3000

# CORS (comma-separated origins for production)
CORS_ORIGINS=

# Logger
LOG_FORMAT=pretty             # pretty | json

# Mail (optional)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_SECURE=false

# Contact form admin recipient (falls back to MAIL_FROM)
CONTACT_ADMIN_EMAIL=

# MCOM Solutions Central Hub (SSO + Billing)
MCOM_SOLUTIONS_URL=http://localhost:3010

# Application OAuth 2.0 Credentials
MCOM_CLIENT_ID=mcom-vcard
MCOM_CLIENT_SECRET=change-me

# Server-to-Server Inter-Service Security
MCOM_SOLUTION_API_KEY=
MCOM_HMAC_SECRET=change-me

# Webhook Verification Secret
MCOM_WEBHOOK_SECRET=

# Shared JWT SSO Secret
SSO_SECRET=change-me

# Configured App Settings
MCOM_PLATFORM_SLUG=vcard
MCOM_REDIRECT_URI=http://localhost:8000/auth/callback
MCOM_SCOPES=profile email business membership packages
MCOM_MEMBERSHIP_URL=http://localhost:3000

# Centralized MCOM Wallet partner integration
# true  → proxy /wallet to MCOM Solutions
# false → use local Postgres wallet tables
MCOM_WALLET_ENABLED=false

# Seed admin (optional — created on first run if provided)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
