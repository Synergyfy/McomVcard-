{
  "name": "mcomvcard-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "node init && pnpm --filter api start:dev",
    "dev:web": "node init && pnpm --filter web dev",
    "dev": "node init && concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "build": "node init && pnpm --filter api build && pnpm --filter web build",
    "build:api": "node init && pnpm --filter api build",
    "build:web": "node init && pnpm --filter web build",
    "migrate": "pnpm --filter api migration:run",
    "seed": "pnpm --filter api seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "pnpm": "^9.15.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  }
}
